{
  "name": "claude-exploration-tree",
  "version": "0.1.0",
  "description": "A Claude Code MCP plugin that visualizes conversation exploration as an interactive tree",
  "type": "module",
  "bin": {
    "claude-exploration-tree": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
